        </mxCell>
        <mxCell id="leyenda_body" value="&lt;div style=&quot;font-family:monospace;font-size:11px;text-align:left;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; = Clave primaria&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = Clave foranea&lt;br&gt;&lt;b&gt;1&lt;/b&gt; = Uno&lt;br&gt;&lt;b&gt;N&lt;/b&gt; = Muchos&lt;br&gt;&lt;b&gt;0..1&lt;/b&gt; = Cero o uno (opcional)&lt;br&gt;&lt;b&gt;--&amp;gt;&lt;/b&gt; = Relacion&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=5;" vertex="1" parent="1">
