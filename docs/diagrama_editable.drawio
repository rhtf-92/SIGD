        </mxCell>
        <mxCell id="notas_t" value="NOTAS DEL MODELO" style="text;html=1;align=center;fontStyle=1;fontSize=14;fontColor=#1A1A66;" vertex="1" parent="1">
          <mxGeometry x="300" y="905" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="notas_body" value="&lt;div style=&quot;font-size:12px;text-align:left;&quot;&gt;&amp;#8226; El estado del requisito (EXPEDIENTE_REQUISITO.estado) se deriva de los ARCHIVOS_ADJUNTOS.&lt;br&gt;&amp;#8226; Las reglas de negocio (peso maximo, conteo de archivos, propagacion de estado, etc.) se implementaran en triggers o en la capa de aplicacion.&lt;br&gt;&amp;#8226; Los campos marcados (ruta_storage, hash_sha256, version_num, id_adjunto_anterior) son propuestas tecnicas pendientes de confirmacion institucional.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=5;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="300" y="930" width="700" height="140" as="geometry" />
        </mxCell>

        <!-- ESTADOS -->
