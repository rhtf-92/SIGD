-- SIGD / DocuCore
-- Esquema de documentos, formularios y captura de valores.
-- Motor objetivo: PostgreSQL 14 o superior.

BEGIN;

CREATE TYPE rol_usuario AS ENUM (
    'ADMINISTRADOR', 'SOLICITANTE', 'EVALUADOR', 'CONSULTANTE'
);

CREATE TYPE tipo_dato_formulario AS ENUM (
    'TEXTO', 'NUMERO', 'FECHA', 'SELECCION'
);

CREATE TYPE estado_expediente AS ENUM (
    'BORRADOR', 'EN_REVISION', 'OBSERVADO', 'APROBADO', 'RECHAZADO_POR_CADUCIDAD'
);

CREATE TABLE usuario (
    id_usuario BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre_completo VARCHAR(200) NOT NULL,
    correo VARCHAR(150) NOT NULL UNIQUE,
    rol rol_usuario NOT NULL,
    activo BOOLEAN NOT NULL DEFAULT TRUE,
    fecha_creacion TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE tipo_documento (
    id_tipo_documento BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo VARCHAR(30) NOT NULL UNIQUE,
    nombre VARCHAR(150) NOT NULL,
    descripcion TEXT,
    activo BOOLEAN NOT NULL DEFAULT TRUE,
    id_usuario_creador BIGINT NOT NULL REFERENCES usuario(id_usuario),
    fecha_creacion TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT ck_tipo_documento_codigo_no_vacio CHECK (btrim(codigo) <> ''),
    CONSTRAINT ck_tipo_documento_nombre_no_vacio CHECK (btrim(nombre) <> '')
);

CREATE TABLE formulario (
    id_formulario BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_tipo_documento BIGINT NOT NULL UNIQUE
        REFERENCES tipo_documento(id_tipo_documento),
    version SMALLINT NOT NULL DEFAULT 1,
    activo BOOLEAN NOT NULL DEFAULT TRUE,
    fecha_creacion TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT ck_formulario_version_positiva CHECK (version > 0)
);

CREATE TABLE campo_formulario (
    id_campo BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_formulario BIGINT NOT NULL REFERENCES formulario(id_formulario) ON DELETE CASCADE,
    nombre_campo VARCHAR(150) NOT NULL,
    tipo_dato tipo_dato_formulario NOT NULL,
    obligatorio BOOLEAN NOT NULL DEFAULT TRUE,
    orden SMALLINT NOT NULL,
    opciones TEXT,
    CONSTRAINT uq_campo_formulario_nombre UNIQUE (id_formulario, nombre_campo),
    CONSTRAINT uq_campo_formulario_orden UNIQUE (id_formulario, orden),
    CONSTRAINT ck_campo_orden_positivo CHECK (orden > 0),
    CONSTRAINT ck_campo_nombre_no_vacio CHECK (btrim(nombre_campo) <> ''),
    CONSTRAINT ck_campo_opciones_seleccion CHECK (
        (tipo_dato = 'SELECCION' AND opciones IS NOT NULL AND btrim(opciones) <> '')
        OR (tipo_dato <> 'SELECCION' AND opciones IS NULL)
    )
);

CREATE TABLE expediente (
    id_expediente BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo_oficial VARCHAR(30) UNIQUE,
    id_tipo_documento BIGINT NOT NULL REFERENCES tipo_documento(id_tipo_documento),
    id_usuario_solicitante BIGINT NOT NULL REFERENCES usuario(id_usuario),
    estado estado_expediente NOT NULL DEFAULT 'BORRADOR',
    fecha_creacion TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_radicacion TIMESTAMPTZ,
    CONSTRAINT ck_expediente_codigo_borrador CHECK (
        (estado = 'BORRADOR' AND codigo_oficial IS NULL AND fecha_radicacion IS NULL)
        OR (estado <> 'BORRADOR' AND codigo_oficial IS NOT NULL AND fecha_radicacion IS NOT NULL)
    )
);

CREATE TABLE valor_campo (
    id_valor_campo BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_expediente BIGINT NOT NULL REFERENCES expediente(id_expediente) ON DELETE CASCADE,
    id_campo BIGINT NOT NULL REFERENCES campo_formulario(id_campo),
    valor TEXT NOT NULL,
    CONSTRAINT uq_valor_campo_expediente_campo UNIQUE (id_expediente, id_campo),
    CONSTRAINT ck_valor_campo_no_vacio CHECK (btrim(valor) <> '')
);

CREATE INDEX ix_formulario_tipo_documento ON formulario(id_tipo_documento);
CREATE INDEX ix_campo_formulario_formulario_orden ON campo_formulario(id_formulario, orden);
CREATE INDEX ix_expediente_tipo_documento ON expediente(id_tipo_documento);
CREATE INDEX ix_expediente_solicitante ON expediente(id_usuario_solicitante);
CREATE INDEX ix_valor_campo_expediente ON valor_campo(id_expediente);

-- Un valor solo puede guardar la respuesta de un campo perteneciente al
-- formulario del tipo de documento elegido para el expediente.
CREATE OR REPLACE FUNCTION fn_validar_campo_del_expediente()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM expediente e
        JOIN formulario f ON f.id_tipo_documento = e.id_tipo_documento
        JOIN campo_formulario c ON c.id_formulario = f.id_formulario
        WHERE e.id_expediente = NEW.id_expediente
          AND c.id_campo = NEW.id_campo
    ) THEN
        RAISE EXCEPTION 'El campo % no pertenece al formulario del expediente %.',
            NEW.id_campo, NEW.id_expediente;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_validar_campo_del_expediente
BEFORE INSERT OR UPDATE OF id_expediente, id_campo ON valor_campo
FOR EACH ROW EXECUTE FUNCTION fn_validar_campo_del_expediente();

COMMIT;