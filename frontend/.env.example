VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ENABLE_MOCKS=false

# --- Lector físico de DNI (agente local) ---
# El navegador no accede directo al chip del DNIe: usa un agente local que expone
# GET /estado y POST /leer con CORS habilitado para el origen del frontend.
VITE_LECTOR_DNI_AGENTE=http://127.0.0.1:51234

# --- Asistente IA (opcional) ---
# Sin estas claves el asistente funciona 100% local.
# Para activar la nube (OpenAI u otro compatible), complete:
# VITE_AI_ENABLED=true
# VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=sk-...
# VITE_AI_MODEL=gpt-4o-mini
