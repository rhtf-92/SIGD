# Plantilla informativa. Ejecute Start-SigdAcademico.ps1 o academic-snapshot/start.mjs
# para crear .env.academico con secretos aleatorios distintos para cada integrante.
# No copie esta plantilla como archivo activo con valores vacíos.

ACADEMIC_PROJECT_NAME=sigd-academico
ACADEMIC_POSTGRES_PORT=5434
ACADEMIC_REDIS_PORT=6380
ACADEMIC_S3_PORT=9001
ACADEMIC_S3_UI_PORT=8889
ACADEMIC_BACKEND_PORT=3001
ACADEMIC_FRONTEND_PORT=5174

# El script de arranque genera estas variables solo en .env.academico:
# ACADEMIC_POSTGRES_PASSWORD
# ACADEMIC_APP_DB_PASSWORD
# ACADEMIC_JWT_SECRET
# ACADEMIC_WEBHOOK_SECRET
# ACADEMIC_S3_ACCESS_KEY
# ACADEMIC_S3_SECRET_KEY
# ACADEMIC_DEMO_PASSWORD
