{
  "name": "sigd-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend oficial del Sistema Integral de Gestión Documentaria (SIGD) — IESTP Suiza",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --config vitest.unit.config.ts --configLoader runner",
    "test:db": "vitest run --config vitest.db.config.ts --configLoader runner",
    "test:e2e": "vitest run --configLoader runner",
    "test:coverage": "vitest run --config vitest.unit.config.ts --configLoader runner --coverage",
    "test:coverage:e2e": "vitest run --config vitest.config.ts --configLoader runner --coverage",
    "load:radicacion": "k6 run k6/escenario-1-radicacion.js",
    "load:derivacion": "k6 run k6/escenario-2-derivacion.js",
    "worker:outbox": "tsx src/audit/worker/outbox-worker.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "smoke:conmutation": "tsx tests/smoke_conmutation_test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.21.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.1.1",
    "testcontainers": "^10.21.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
