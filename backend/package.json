{
  "name": "sigd-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend oficial del Sistema Integral de Gestión Documentaria (SIGD) — IESTP Suiza",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run",
    "load:radicacion": "k6 run k6/escenario-1-radicacion.js",
    "load:derivacion": "k6 run k6/escenario-2-derivacion.js",
    "worker:outbox": "tsx src/audit/worker/outbox-worker.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
