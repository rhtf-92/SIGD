# Aplicación SIGD Backend — B_TAPULLIMA
PORT=3008
NODE_ENV=development

# Base de Datos PostgreSQL 18 Oficial (sigd_jacobo_demo)
DATABASE_URL=postgres://postgres:postgres_password@127.0.0.1:5433/sigd_jacobo_demo

# Seguridad JWT y CORS
AUTH_JWT_SECRET=sigd_institucional_jwt_secret_super_seguro_2026_iestp_suiza_32b
CORS_ORIGIN=http://localhost:5178,http://127.0.0.1:5178,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Redis 7 para sesiones efímeras de firma (TTL 300s, consumo atómico con GETDEL)
REDIS_URL=redis://127.0.0.1:6379

# Almacenamiento S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=sigd-expedientes

# Host público que se expone en la URI refirma:// y en la URL de callback.
HOST_PUBLICO=http://127.0.0.1:3008

# Pasarela Refirma RENIEC
REFIRMA_HOSTS_PERMITIDOS=localhost,127.0.0.1,sigd.iestp-suiza.edu.pe
REFIRMA_EXIGIR_HTTPS=false
REFIRMA_WEBHOOK_SECRET=secreto_webhook_refirma_desarrollo_2026

# Configuración del Worker Transactional Outbox
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_TECHO_MS=300000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_WORKER_ENABLED=true

# Pipeline DDL
MIGRATIONS_DIR=migraciones
MIGRATE_ADVISORY_LOCK_ID=987654321
MIGRATE_ON_BOOT=true
SIGD_SAFE_BOOT=false

# Suite de Pruebas E2E (Testcontainers)
TESTCONTAINERS_IMAGE=postgres:18-alpine

# Pruebas de Rendimiento k6
BASE_URL=http://localhost:3008
