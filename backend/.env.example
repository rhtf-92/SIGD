# Aplicación SIGD Backend
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL 18
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigd_prueba

# Seguridad JWT y CORS
AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Redis 7 para sesiones efímeras de firma (TTL 300s, consumo atómico con GETDEL)
REDIS_URL=redis://localhost:6379

# Host público que se expone en la URI refirma:// y en la URL de callback.
HOST_PUBLICO=https://sigd.iestp-suiza.edu.pe

# Pasarela Refirma RENIEC
REFIRMA_HOSTS_PERMITIDOS=localhost,127.0.0.1,sigd.iestp-suiza.edu.pe
REFIRMA_EXIGIR_HTTPS=false
REFIRMA_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# Configuración del Worker Transactional Outbox
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_TECHO_MS=300000
OUTBOX_POLL_INTERVAL_MS=5000

# Pipeline DDL (Advisory Lock de sesión; debe coincidir en todas las réplicas)
MIGRATIONS_DIR=migraciones
MIGRATE_ADVISORY_LOCK_ID=987654321
MIGRATE_ON_BOOT=true

# Suite de Pruebas E2E (Testcontainers)
TESTCONTAINERS_IMAGE=postgres:18-alpine

# Pruebas de Rendimiento k6
BASE_URL=http://localhost:3000

# Almacenamiento compatible con S3 (MinIO/SeaweedFS/AWS S3)
S3_ENDPOINT=http://localhost:9000
# URL que reciben los navegadores. En Docker, S3_ENDPOINT es interno y esta URL es pública.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sigd-expedientes
S3_ACCESS_KEY=EXAMPLE_S3_ACCESS_KEY
S3_SECRET_KEY=EXAMPLE_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRATION_SEGUNDOS=900

# Compatibilidad con el servicio SDK heredado
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=EXAMPLE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=EXAMPLE_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=sigd-expedientes

# Runtime local
START_FRONTEND=false
MGD_REFRESH_MS=60000
ALLOW_HEADER_IDENTITY=false
OUTBOX_BRIDGE_ENABLED=true

# Asistente Virtual Institucional (AsistenteCore)
# Motor: faq (solo reglas) o hibrido (FAQ + LLM RAG sobre la documentación).
# La API key se configura solo en el backend (NUNCA en el frontend).
ASISTENTE_MOTOR=hibrido
ASISTENTE_UMBRAL_CONFIANZA=0.6
# Proveedor: gemini u openai. Si se omite, usa Gemini cuando GEMINI_API_KEY existe.
ASISTENTE_LLM_PROVEEDOR=gemini
# GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
# ASISTENTE_LLM_MODELO=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Alternativa OpenAI:
# OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY
# ASISTENTE_LLM_MODELO=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ASISTENTE_LLM_TIMEOUT_MS=20000
# El RAG solo indexa Markdown revisado y aprobado en backend/knowledge/asistente/.
