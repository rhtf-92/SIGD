# Aplicación SIGD Backend
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL 18
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigd_prueba

# Redis 7: cache de permisos RBAC (OC-10/OC-11) y sesiones de firma.
REDIS_URL=redis://localhost:6379

# Identidad de los endpoints RBAC (OC-12).
# Secreto HMAC-SHA256 de los tokens de acceso. Minimo 32 caracteres; sin el, los
# endpoints /api/v1/admin/roles-permisos responden 500 porque no hay nada que verificar.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# ONLY true habilita aceptar la identidad por la cabecera `x-usuario-id` sin JWT.
# La API nativa EventSource no envia cabeceras, de ahi la compatibilidad; en
# produccion debe ser false para no admitir identidades afirmadas por el cliente.
ALLOW_HEADER_IDENTITY=false

# Configuración del Worker Transactional Outbox
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_TECHO_MS=300000
OUTBOX_POLL_INTERVAL_MS=5000

# Suite de Pruebas E2E
# Con Docker/Podman se ignora esta variable y la suite levanta su propio contenedor
# efímero (testcontainers). Sin runtime de contenedores, comenta la línea y crea la
# base `sigd_prueba` con createdb para que la suite use tu PostgreSQL local.
# TEST_DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/sigd_prueba
TESTCONTAINERS_IMAGE=postgres:18-alpine
MIGRATIONS_DIR=migraciones
MIGRATE_ADVISORY_LOCK_ID=987654321
# false desactiva la migracion automatica y obliga a npm run migrate
MIGRATE_ON_BOOT=true

# Secreto compartido para autenticar callbacks recibidos desde Refirma.
REFIRMA_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Lista blanca de hosts permitidos en la pasarela Refirma (separados por comas).
REFIRMA_HOSTS_PERMITIDOS=sigd.iestp-suiza.edu.pe

# Exigir HTTPS en las URLs del payload (true/false). En produccion debe ser true.
REFIRMA_EXIGIR_HTTPS=true

# Pruebas de Rendimiento k6
BASE_URL=http://localhost:3000

