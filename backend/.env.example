NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:contrasena_de_ejemplo@localhost:5432/sigd_ejemplo

# Redis 7 para sesiones efímeras de firma (TTL 300s, consumo atómico con GETDEL)
REDIS_URL=redis://localhost:6379

# Host público que se expone en la URI refirma:// y en la URL de callback.
# Debe coincidir con uno de los hosts de la lista blanca.
HOST_PUBLICO=https://sigd.iestp-suiza.edu.pe

# Lista blanca de hosts permitidos en la pasarela Refirma (separados por comas).
# La URI refirma:// solo acepta URLs de documento y callback cuyo host esté aquí.
REFIRMA_HOSTS_PERMITIDOS=sigd.iestp-suiza.edu.pe

# Exigir HTTPS en las URLs del payload (true/false). En producción debe ser true.
REFIRMA_EXIGIR_HTTPS=true