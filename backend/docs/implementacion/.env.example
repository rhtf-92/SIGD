# Auditoría / Outbox
# EJEMPLO LOCAL DE DESARROLLO (NO PRODUCTIVO): credenciales de la instancia PostgreSQL 16 local,
# usadas solo para pruebas en esta máquina. En cualquier entorno real defina DATABASE_URL explícitamente.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigd_prueba

# Aplicación
PORT=3000
NODE_ENV=development

# Worker outbox
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_POLL_INTERVAL_MS=5000

# Testcontainers (suite E2E) — opcional si se define TEST_DATABASE_URL
TESTCONTAINERS_IMAGE=postgres:18-alpine

# PostgreSQL local (alternativa a Docker) — descomentar solo en este entorno de desarrollo local.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigd_prueba

# Carga k6
BASE_URL=http://localhost:3000