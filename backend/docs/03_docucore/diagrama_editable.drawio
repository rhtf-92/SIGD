        <mxCell id="title1" value="DIAGRAMA DEL MODELO DE DATOS - SIGD (MÓDULO DOCUCORE)" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A1A66;" vertex="1" parent="1">
