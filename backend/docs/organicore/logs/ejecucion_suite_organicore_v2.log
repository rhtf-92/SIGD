-- [Sep, Oct) y [Oct, Nov) no se tocan; la exclusion no debe bloquearlas.
-- ---------------------------------------------------------------------------
DO $$
DECLARE
    n INTEGER;
BEGIN
    SELECT count(*) INTO n FROM sigd_org.encargatura_despacho
     WHERE cargo_id = '00000000-0000-0000-0000-000000000201' AND activo;

    IF n = 3 THEN
