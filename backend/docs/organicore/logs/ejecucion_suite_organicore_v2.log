-- FIRMA_VENCIDA termina el 2026-09-15; con p_momento 2026-09-20 deniega
-- aunque CURRENT_DATE (anterior al corte) hubiera autorizado.
-- ---------------------------------------------------------------------------
DO $$
DECLARE
