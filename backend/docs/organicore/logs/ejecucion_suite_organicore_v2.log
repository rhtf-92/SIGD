-- ---------------------------------------------------------------------------
-- QA-014: ABAC - encargatura expirada respecto a p_momento (borde exclusivo).
-- ---------------------------------------------------------------------------
DO $$
DECLARE
    v_expirado BOOLEAN;
BEGIN
    SELECT sigd_org.usuario_tiene_facultad_despacho(
        '00000000-0000-0000-0000-000000000302',
        '00000000-0000-0000-0000-000000000101',
        '00000000-0000-0000-0000-000000000201',
        '2026-10-01 00:00+00') INTO v_expirado;

    IF NOT v_expirado THEN
        INSERT INTO log_pruebas VALUES
            ('QA-014', 'OK', 'ABAC: encargatura expirada (borde exclusivo) deniega');
    ELSE
        INSERT INTO log_pruebas VALUES
            ('QA-014', 'FAIL: se autorizo una facultad fuera del periodo',
             'ABAC: encargatura expirada (borde exclusivo) deniega');
    END IF;
END;
$$;
DO
-- ===========================================================================
-- Cierre: imprimir el log de ejecucion real y fallar si alguna prueba no paso.
-- ===========================================================================
SELECT id_prueba, resultado, descripcion
FROM log_pruebas
ORDER BY id_prueba;
 id_prueba | resultado |                                  descripcion                                  
-----------+-----------+-------------------------------------------------------------------------------
 QA-001    | OK        | Path materializado y niveles (101 > 102 > 103 > 104)
 QA-002    | OK        | Ciclo directo rechazado con SQLSTATE 23514
 QA-003    | OK        | Movimiento de subarbol con propagacion en cascada (102/103/104 bajo 105)
 QA-004    | OK        | Ciclo indirecto: 105 bajo 104 rechazado con SQLSTATE 23514
 QA-005    | OK        | Ciclo indirecto: 102 bajo 104 rechazado con SQLSTATE 23514
 QA-006    | OK        | Movimiento con delta de nivel propagado en cascada (idem al restaurar)
 QA-007    | OK        | Integridad del arbol tras rechazos de ciclos y reposicionamientos
 QA-008    | OK        | Solapamiento parcial rechazado por ex_encargatura_cargo_periodo
 QA-009    | OK        | Adyacencia valida: 3 encargaturas activas en cargo 201 sin solaparse
 QA-010    | OK        | Solapamiento por punto ([] con [) rechazado por la exclusion GiST
 QA-011    | OK        | ABAC estricto con p_momento: facultad futura deniega antes y autoriza despues
 QA-012    | OK        | ABAC estricto con p_momento: facultad vencida deniega despues del corte
 QA-013    | OK        | ABAC: facultad vigente dentro del periodo autoriza
 QA-014    | OK        | ABAC: encargatura expirada (borde exclusivo) deniega
(14 filas)

DO $$
DECLARE
    fallas INTEGER;
BEGIN
    SELECT count(*) INTO fallas FROM log_pruebas WHERE resultado <> 'OK';
    IF fallas > 0 THEN
        RAISE EXCEPTION 'SUITE_FAIL: % prueba(s) no superaron la ejecucion', fallas;
    END IF;
END;
$$;
