        INSERT INTO log_pruebas VALUES
            ('QA-009', 'FAIL: se obtuvieron ' || n || ' encargaturas activas',
             'Adyacencia valida: 3 encargaturas activas en cargo 201 sin solaparse');
    END IF;
END;
$$;
