# ==============================================================================
# SIGD - Variables de entorno para Docker Compose
# ------------------------------------------------------------------------------
# Copie este archivo a `.env` y reemplace los valores marcados con CAMBIE_.
# `.env` esta ignorado por git: nunca se versionan credenciales reales.
# ==============================================================================

# --- Entorno y zona horaria ---
NODE_ENV=development
TZ=America/Lima

# --- PostgreSQL 18 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASENA_POSTGRES
POSTGRES_DB=sigd_prueba
# Puerto del host (5433 evita chocar con un PostgreSQL local en 5432).
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=3000
# Minimo 32 caracteres (lo exige src/core/auth/jwt.service.ts).
AUTH_JWT_SECRET=CAMBIE_ESTE_SECRETO_JWT_DE_AL_MENOS_32_CARACTERES
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
HOST_PUBLICO=http://localhost:3000

# --- Pasarela Refirma (RENIEC) ---
REFIRMA_HOSTS_PERMITIDOS=localhost,127.0.0.1
REFIRMA_EXIGIR_HTTPS=false
REFIRMA_WEBHOOK_SECRET=CAMBIE_ESTE_SECRETO_WEBHOOK_REFIRMA

# --- Worker Transactional Outbox ---
OUTBOX_LOTE=100
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_TECHO_MS=300000
OUTBOX_POLL_INTERVAL_MS=5000

# --- Pipeline DDL ---
# Regla del proyecto: las migraciones NO se ejecutan automaticamente.
# Para inicializar una base Docker vacia, cambie a true de forma consciente.
MIGRATE_ON_BOOT=false
MIGRATIONS_DIR=migraciones
MIGRATE_ADVISORY_LOCK_ID=987654321

# --- Redis 7 ---
REDIS_PORT=6379

# --- MinIO / S3 (servicio opcional, perfil "storage") ---
# El repositorio oficial de Docker Hub ya no publica minio/minio.
# Si cuenta con una imagen valida, indiquela aqui y levante:
#   docker compose --profile storage up -d
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIE_ESTA_CONTRASENA_MINIO
MINIO_BUCKET_NAME=sigd-documentos
S3_REGION=us-east-1
S3_BUCKET=sigd-expedientes
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Frontend ---
FRONTEND_PORT=5173
# URL que usa el NAVEGADOR para llegar al backend.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ENABLE_MOCKS=false
