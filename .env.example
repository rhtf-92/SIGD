# Copiar como .env y completar con cuentas locales; nunca usar credenciales reales de producción.
# POSTGRES_USER/PASSWORD son únicamente la cuenta bootstrap de PostgreSQL.
POSTGRES_USER=CAMBIAR_USUARIO_BOOTSTRAP
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES
POSTGRES_DB=CAMBIAR_BASE_POSTGRES

# Cuenta de runtime con permisos mínimos. No usar POSTGRES_USER.
# La cuenta debe existir previamente; esta configuración no crea ni altera roles.
DATABASE_URL=

# Cuenta separada, solo para una ejecución manual y aprobada del CLI de migraciones.
# No se inyecta al backend de runtime.
MIGRATOR_DATABASE_URL=

S3_ACCESS_KEY=CAMBIAR_USUARIO_S3
S3_SECRET_KEY=CAMBIAR_PASSWORD_S3
AUTH_JWT_SECRET=CAMBIAR_SECRETO_JWT_ALEATORIO_DE_AL_MENOS_32_CARACTERES
